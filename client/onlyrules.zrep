# Scoped replication commands for zrep; keep client/onlyrules.zrep in sync.
\:^exit$:{p;q}
\:^command -v mbuffer$:{p;q}
\:^command -v lzop$:{p;q}
\:^echo -n$:{p;q}
\:^incus snapshot create \([A-Za-z0-9][A-Za-z0-9.-]*\) zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*$:{p;q}
\:^lxc snapshot \([A-Za-z0-9][A-Za-z0-9.-]*\) zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*$:{p;q}
\:^sudo zfs destroy 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)$:{p;q}
\:^sudo zfs get -H syncoid\:sync 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'$:{p;q}
\:^sudo zfs get -Hpd 1 -t snapshot guid,creation '\(tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*\)'$:{p;q}
\:^sudo zfs list -o name,origin -t filesystem,volume -Hr 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'$:{p;q}
\:^sudo zfs send -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@'syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@'syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)' | lzop | mbuffer -q -s 128k -m 16M 2>/dev/null$:{p;q}
\:^sudo zfs send -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@'snapshot-[A-Za-z0-9][A-Za-z0-9.-]*' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@'syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)' | lzop | mbuffer -q -s 128k -m 16M 2>/dev/null$:{p;q}
\:^sudo zfs send 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)'$:{p;q}
\:^sudo zfs send 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)' | lzop | mbuffer -q -s 128k -m 16M 2>/dev/null$:{p;q}
\:^sudo zfs send -nvP 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)'$:{p;q}
\:^sudo zfs send -nvP -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)'$:{p;q}
\:^sudo zfs snapshot 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/\([A-Za-z0-9][A-Za-z0-9.-]*\)'@syncoid_\([A-Za-z0-9][A-Za-z0-9.-]*\)_\([0-9GMT:-]*\)$:{p;q}
\:^zpool get -o value -H feature@extensible_dataset 'tank'$:{p;q}
\:^sudo zfs send -t \([a-z0-9-]*\) | lzop | mbuffer -q -s 128k -m 16M 2>/dev/null$:{p;q}
\:^sudo zfs send -nP -t \([a-z0-9-]*\)$:{p;q}
\:^sudo zpool get -o value -H feature@extensible_dataset 'tank'$:{p;q}
\:^sudo zfs send 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)'\( | lzop\)\?\( | mbuffer -q -s 128k -m 16M 2>/dev/null\)\?$:{p;q}
\:^sudo zfs send -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)'\( | lzop\)\?\( | mbuffer -q -s 128k -m 16M 2>/dev/null\)\?$:{p;q}
