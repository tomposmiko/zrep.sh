\:^sudo zfs send -nvP -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)'\( | lzop\)\?\( | mbuffer -q -s 128k -m 16M 2>/dev/null\)\?$:{p;q}
\:^sudo zfs send -nP 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)'\( | lzop\)\?\( | mbuffer -q -s 128k -m 16M 2>/dev/null\)\?$:{p;q}
\:^sudo zfs send -nP -I 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)' 'tank/\(incus\|lxd\)/\(containers\|virtual-machines\)/[A-Za-z0-9][A-Za-z0-9.-]*'\?@'\?\(snapshot-zas-\(hourly\|daily\|weekly\|monthly\)-[0-9-]*\|syncoid_[A-Za-z0-9_.:-]*\)'\( | lzop\)\?\( | mbuffer -q -s 128k -m 16M 2>/dev/null\)\?$:{p;q}
